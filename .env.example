# Replace every placeholder below; this value is intentionally not runnable as-is.
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/DATABASE?sslmode=require
Jwt__Issuer=portfolio-lojas-pedidos
Jwt__Audience=portfolio-lojas-pedidos
Jwt__Key=replace-with-a-secret-of-at-least-32-bytes
# Optional initial user, matching the ASP.NET seeding convention:
SeedUser__Username=
SeedUser__Password=
SeedUser__ResetPasswordOnStartup=false
# Required only for product image uploads:
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=
R2_PUBLIC_URL=
R2_ENDPOINT=
